# Copy this file to `.env` and fill in only the keys you want to use.
# Every key is optional: without any keys the app runs in the free,
# in-browser "Free preview" mode.

# Port for the local web server.
PORT=3000
# 127.0.0.1 = this computer only. Use 0.0.0.0 to open the app from a phone on
# the same Wi-Fi (anyone on that network could then use your API keys).
HOST=127.0.0.1

# --- AI photo rendering (paid) -------------------------------------------
# OpenAI image editing (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Image model used for renders. Change it if OpenAI releases a newer one.
OPENAI_IMAGE_MODEL=gpt-image-1
# "high" keeps the room layout closer to the photo (costs more). Leave empty to omit.
OPENAI_INPUT_FIDELITY=high
# low | medium | high | auto
OPENAI_IMAGE_QUALITY=medium

# Google Gemini image editing (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- AI reference check (paid, optional) ----------------------------------
# Claude looks at your photo and references and flags layout/scale
# conflicts and writes a style brief for the AI renderers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Video ------------------------------------------------------------------
# Path to ffmpeg. Only used when the browser cannot encode MP4 itself.
FFMPEG_PATH=ffmpeg
